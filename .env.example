# ============================================================================
# ACADEMIA MATEMATICAS CABSA - PLANTILLA DE CONFIGURACION
# ============================================================================
# Copie este archivo como `.env` y reemplace los valores `configure-*`.
# Docker Compose, scripts, Gateway y Vite leen el `.env` de la raiz.

# 1. ENTORNO GENERAL
# NODE_ENV es para ejecución directa; Docker utiliza DOCKER_NODE_ENV.
NODE_ENV=development
DOCKER_NODE_ENV=production
COMPOSE_PROJECT_NAME=academia-matematicas-final
SERVICE_HOST=0.0.0.0
GATEWAY_NAME=academia-matematicas-api-gateway

# 2. ACCESO PUBLICO: IP, DNS Y HTTPS
# DNS_ACTIVO=false usa SERVER_IP y puertos. true usa los dos nombres DNS de frontend.
# HTTPS_ACTIVO=true agrega el proxy Nginx TLS y requiere DNS_ACTIVO=true.
DNS_ACTIVO=false
HTTPS_ACTIVO=false
SERVER_IP=auto
IP_DETECTION_MODE=public
DNS_PORTAL_HOST=matematicas.academiacabsa.com
DNS_ADMIN_HOST=administracion.matematicas.academiacabsa.com
DNS_API_HOST=api.matematicas.academiacabsa.com
# Valores preparados para DNS+HTTPS; configurar-entorno.sh genera los activos.
DNS_CORS_ORIGINS=https://matematicas.academiacabsa.com,https://administracion.matematicas.academiacabsa.com
DNS_API_PUBLIC_URL=https://api.matematicas.academiacabsa.com
DNS_PORTAL_PUBLIC_URL=https://matematicas.academiacabsa.com
DNS_ADMIN_PUBLIC_URL=https://administracion.matematicas.academiacabsa.com

# 3. MYSQL: BASE UNICA EXTERNA
# DB_HOST es para procesos del host; MYSQL_HOST_CONTENEDORES para Docker.
# Cambiar el modo IP/DNS público no modifica ni recrea esta base.
MYSQL_DOCKER_ACTIVO=false
MYSQL_HOST_EXTERNO=172.16.17.2
MYSQL_HOST_CONTENEDORES=172.16.17.2
DB_HOST=172.16.17.2
DB_PORT=3306
DB_NAME=academia-matematicas-soa
DB_USER=configure-db-user
DB_PASSWORD=configure-db-password

# 4. PUERTOS
# 4601-4604 y 4600 permanecen dentro de Docker; 5176/5177 son Vite local;
# únicamente 4610/4611 publican los frontends.
GATEWAY_PORT=4600
LEARNING_PORT=4601
PRACTICE_PORT=4602
AI_PORT=4603
IDENTITY_PORT=4604
STUDENT_PORT=5176
ADMIN_PORT=5177
STUDENT_DOCKER_PORT=4610
ADMIN_DOCKER_PORT=4611
PREVIEW_DOCKER_PORT=4612

# 5. SEGURIDAD Y SESIONES
# Genere secretos aleatorios de 32 caracteres o más. Nunca publique `.env`.
JWT_SECRET=configure-secure-jwt-secret
JWT_EXPIRES_IN=8h
INTERNAL_SERVICE_KEY=configure-secure-internal-key
AUTH_REQUIRED=true

# 6. GATEWAY: CORS, TIMEOUT, RATE LIMIT Y PROXY
# CORS_ORIGINS acepta varios orígenes separados por comas. En modo DNS el
# configurador conserva también los dos orígenes por IP para administración.
# TRUST_PROXY_HOPS pasa a 1 cuando HTTPS funciona detrás de Nginx.
CORS_ORIGINS=http://192.168.0.6:4610,http://192.168.0.6:4611
REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
TRUST_PROXY_HOPS=1

# 7. URLS DE MICROSERVICIOS
# Las primeras son para ejecución directa. Las *_DOCKER_SERVICE_URL pertenecen
# al DNS privado `academia-math`; el navegador nunca las consume directamente.
LEARNING_SERVICE_URL=http://127.0.0.1:4601
PRACTICE_SERVICE_URL=http://127.0.0.1:4602
AI_SERVICE_URL=http://127.0.0.1:4603
IDENTITY_SERVICE_URL=http://127.0.0.1:4604
LEARNING_DOCKER_SERVICE_URL=http://learning-service:4601
PRACTICE_DOCKER_SERVICE_URL=http://practice-service:4602
AI_DOCKER_SERVICE_URL=http://ai-service:4603
IDENTITY_DOCKER_SERVICE_URL=http://identity-service:4604

# 8. URLS PUBLICAS ACTIVAS Y VITE
# El configurador sincroniza estos valores. Al cambiarlos, reconstruya frontend.
PUBLIC_HOST=192.168.0.6
API_PUBLIC_URL=/
PORTAL_PUBLIC_URL=http://192.168.0.6:4610
ADMIN_PUBLIC_URL=http://192.168.0.6:4611
VITE_GATEWAY_PORT=
VITE_STUDENT_API_URL=
VITE_ADMIN_API_URL=
VITE_STUDENT_APP_URL=http://192.168.0.6:4610

# 9. PROVEEDORES DE INTELIGENCIA ARTIFICIAL
# OLLAMA_URL: host. OLLAMA_DOCKER_URL: ai-service. OpenAI es opcional.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
OPENAI_API_KEY=

# 10. RESPALDOS
BACKUP_NAME=academia-matematicas-soa
BACKUP_DIRECTORY=database/backups
